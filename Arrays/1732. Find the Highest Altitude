class Solution {
public:
    int largestAltitude(vector<int>& gain) {

        vector <int> alt;
        int final;
        for(int i=0;i<=gain.size();i++)
        {
            if(i==0) alt.push_back(0);

            else
            {
                final = gain[i-1]+alt[i-1];
                alt.push_back(final);
            }
        }

        return *max_element(alt.begin(),alt.end());
        
    }
};
