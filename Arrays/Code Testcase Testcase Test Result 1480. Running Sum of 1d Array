class Solution {
public:
    vector<int> runningSum(vector<int>& nums) {

        vector <int> a;
        int final;

        for(int i=0;i<nums.size();i++)
        {
            if(i==0) a.push_back(nums[i]);
            else
            {
                final = nums[i]+a[i-1];
                a.push_back(final);
            }
        }
        return a;
        
    }
};
