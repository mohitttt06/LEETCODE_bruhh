class Solution {
public:
    vector<int> twoSum(vector<int>& numbers, int target) {

        vector <int> final;
        
        int f=0;
        int l=numbers.size()-1;
        for(int i=0;i<numbers.size();i++)
        {
            if(numbers[f]+numbers[l]==target)
            {
                final.push_back(f+1);
                final.push_back(l+1);
                break;
                
            }
            else if(numbers[f]+numbers[l]>target)
            {
                l--;
            }
            else
            {
                f++;
            }
        }
        return final;

        
    
}
};
