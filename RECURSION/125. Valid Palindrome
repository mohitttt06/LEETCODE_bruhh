class Solution {
public:
    bool isPalindrome(string s) {

        string str;
        char k;
        
        for(int i=0;i<s.size();i++)
        {
            if(s[i]>='A'&&s[i]<='Z')
            {
                k = tolower(s[i]);
                str.push_back(k);
            }
            else if(s[i]>='a'&&s[i]<='z')
            {
                str.push_back(s[i]);
            }
            else if(s[i]>='1'&&s[i]<='9')
            {
                str.push_back(s[i]);
            }
            else if(s[i]=='0')
            {
                str.push_back(s[i]);
            }
            else
            {
                
                continue;
            }
        }
        
        int l=0;
        int r=str.size()-1;
        bool p = false;

        for(int i=0;i<str.size();i++)
        {
            if(l>=r)
            {
                p=true;
                break;
            }
            else if(str[l]==str[r])
            {
                l++;
                r--;
            }
           
            
            
        }

        if(p==true)
        {
            return true;
        }
        
        else if(str.size()==1||str.size()==0)
        {
            return true;
        }
        
        else
        {
            return false;
        }

    }   

};      
